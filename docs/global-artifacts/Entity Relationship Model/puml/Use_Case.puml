@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

title Use Case Diagram
left to right direction

actor "Admin" as a
actor "User" as u

rectangle "StockFlow System" {

    rectangle "Category Management" {
    usecase "Create Category" as UC1
    usecase "List Categories" as UC2
    usecase "Update Category" as UC3
    usecase "Delete Category" as UC4
    }

    rectangle "Supplier Management" {
    usecase "Create Supplier" as UC5
    usecase "List Suppliers" as UC6
    usecase "Update Supplier" as UC7
    usecase "Delete Supplier" as UC8
    }

    rectangle "Product Management" {
    usecase "Create Product" as UC9
    usecase "List Products" as UC10
    usecase "Update Product" as UC11
    usecase "Delete Product" as UC12
    }

    rectangle "Stock Movement Management" {
    usecase "Create Stock Movement" as UC13
    usecase "List Stock Movements" as UC14
    usecase "Update Stock Movement" as UC15
    usecase "Delete Stock Movement" as UC16
    }

    rectangle "User Management" {
    usecase "Create User" as UC17
    usecase "List Users" as UC18
    usecase "Update User" as UC19
    usecase "Delete User" as UC20
    }

    rectangle "Authentication"{
    usecase "Login" as UC21
    usecase "Logout" as UC22
    }
}

